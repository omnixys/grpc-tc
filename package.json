{
  "name": "@omnixys/grpc-ts",
  "version": "1.0.5",
  "type": "module",
  "private": false,
  "packageManager": "pnpm@10.33.0",
  "description": "gRPC infrastructure module for Omnixys microservices — proto definitions, client/server modules, interceptors, and types",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "proto"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./clients": {
      "types": "./dist/clients/index.d.ts",
      "import": "./dist/clients/index.js"
    },
    "./servers": {
      "types": "./dist/servers/index.d.ts",
      "import": "./dist/servers/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./proto": {
      "import": "./dist/proto/user.proto",
      "default": "./dist/proto/user.proto"
    },
    "./proto/*": {
      "default": "./dist/proto/*"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "postbuild": "cp -r src/proto dist/proto",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "clean": "rimraf dist",
    "dev": "tsc -w",
    "release": "semantic-release",
    "link": "pnpm link --global"
  },
  "keywords": [
    "omnixys",
    "grpc",
    "microservices"
  ],
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.7.15",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/microservices": "^11.1.28",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^25.9.5",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.8",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.1.17",
    "@nestjs/microservices": "^11.1.27",
    "@omnixys/context-ts": "^3.1.1",
    "@omnixys/logger-ts": "^3.2.2",
    "@omnixys/observability-ts": "^3.2.2"
  }
}
